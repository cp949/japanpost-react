{
  "$schema": "https://unpkg.com/release-it@21/schema/release-it.json",
  "hooks": {
    "before:init": "cd ../.. && pnpm readme:package:check && pnpm lint && pnpm check-types && pnpm test && pnpm build --force",
    "after:bump": "git add --update ../../CHANGELOG.md"
  },
  "git": {
    "requireCleanWorkingDir": true,
    "requireUpstream": true,
    "commitMessage": "chore: @cp949/japanpost-react v${version} 배포",
    "tagName": "v${version}",
    "tagAnnotation": "@cp949/japanpost-react v${version}",
    "push": true
  },
  "npm": {
    "publish": true,
    "publishPackageManager": "pnpm",
    "publishArgs": ["--access", "public", "--no-git-checks"]
  },
  "github": {
    "release": false
  },
  "plugins": {
    "@release-it/keep-a-changelog": {
      "filename": "../../CHANGELOG.md",
      "addUnreleased": true
    }
  }
}
