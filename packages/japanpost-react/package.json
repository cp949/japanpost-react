{
  "name": "@cp949/japanpost-react",
  "version": "1.1.0",
  "description": "Headless React hooks and optional components for Japan Post postcode and address search",
  "type": "module",
  "author": "cp949",
  "license": "ISC",
  "repository": {
    "type": "git",
    "url": "https://github.com/cp949/japanpost-react.git"
  },
  "homepage": "https://github.com/cp949/japanpost-react",
  "bugs": {
    "url": "https://github.com/cp949/japanpost-react/issues"
  },
  "main": "dist/index.es.js",
  "module": "dist/index.es.js",
  "types": "dist/index.d.ts",
  "sideEffects": false,
  "files": [
    "dist",
    "!dist/**/*.map",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=24.18"
  },
  "browserslist": [
    "chrome >= 80"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.es.js"
    },
    "./client": {
      "types": "./dist/client.d.ts",
      "import": "./dist/client.es.js"
    }
  },
  "scripts": {
    "dev": "tsup --config tsup.config.ts --watch",
    "build": "tsup --config tsup.config.ts && node scripts/postbuild.mjs && browser-baseline check",
    "compat:check": "browser-baseline check",
    "prepublishOnly": "pnpm build",
    "lint": "biome lint .",
    "check-types": "tsc --noEmit && tsc --noEmit -p tsconfig.src.json",
    "test": "pnpm test:unit",
    "test:unit": "vitest run",
    "test:watch": "vitest"
  },
  "keywords": [
    "japan",
    "postcode",
    "postal-code",
    "address",
    "react"
  ],
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  },
  "devDependencies": {
    "@repo/browser-baseline": "workspace:*",
    "@repo/typescript-config": "workspace:*",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "esbuild": "^0.28.2",
    "jsdom": "^30.1.3",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tsup": "^8.5.1",
    "typescript": "6.0.3",
    "vitest": "^4.1.12"
  }
}
